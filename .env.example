# ============================================================================
# AI Meeting Minutes — environment configuration
# Copy to .env and fill in. NEVER commit .env. Real secrets belong in Key Vault.
# See docs/setup-credentials.md for where each value comes from.
# ============================================================================

# --- Provider switches (mock = works offline with samples/) ---------------
# mock | entra
AUTH_MODE=mock
# mock | real
GRAPH_MODE=mock
# mock | azure | gemini
STT_PROVIDER=mock
# mock | azure_openai | gemini
SUMMARIZER=mock

# --- Frontend (build-time) -------------------------------------------------
# must match AUTH_MODE
NEXT_PUBLIC_AUTH_MODE=mock
NEXT_PUBLIC_ENTRA_TENANT_ID=
# SPA app registration (or same app)
NEXT_PUBLIC_ENTRA_SPA_CLIENT_ID=
# e.g. api://<api-client-id>/access_as_user
NEXT_PUBLIC_ENTRA_API_SCOPE=

# --- Microsoft Entra ID (backend API app registration) --------------------
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
# OBO only; prefer certificate / Key Vault
ENTRA_API_CLIENT_SECRET=
# default api://<ENTRA_API_CLIENT_ID>
ENTRA_API_AUDIENCE=
# optional app role, e.g. MoM.Approver
ENTRA_APPROVER_ROLE=

# Delegated Graph scopes requested via On-Behalf-Of (space separated)
GRAPH_SCOPES_SHAREPOINT_READ=https://graph.microsoft.com/Files.Read.All
GRAPH_SCOPES_SHAREPOINT_WRITE=https://graph.microsoft.com/Files.ReadWrite.All
GRAPH_SCOPES_TEAMS_READ=https://graph.microsoft.com/Chat.ReadBasic https://graph.microsoft.com/ChatMember.Read
GRAPH_SCOPES_TEAMS_SEND=https://graph.microsoft.com/ChatMessage.Send https://graph.microsoft.com/Chat.Read

# --- SharePoint --------------------------------------------------------------
# comma separated: contoso.sharepoint.com,<guid>,<guid>
SHAREPOINT_ALLOWED_SITE_IDS=
# empty = save next to the source audio
SHAREPOINT_REPORT_DRIVE_ID=
SHAREPOINT_REPORT_FOLDER=MeetingReports

# --- Azure AI Speech ---------------------------------------------------------
AZURE_SPEECH_KEY=
# e.g. southeastasia
AZURE_SPEECH_REGION=
# optional custom domain/private endpoint
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_API_VERSION=2024-11-15

# --- Azure OpenAI ------------------------------------------------------------
# https://<resource>.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Google Gemini (dev only — free tier may use data for training; synthetic audio only)
GEMINI_API_KEY=
# models tried in order; on overload (503), throttling (429) or 404 the next one is used.
# gemini-3.6-flash is fast on the free tier; gemini-3.8-flash is newer but often overloaded;
# gemini-3.5-flash-lite is the lightweight last resort when both are busy.
# (gemini-2.5-flash is no longer available to new API keys)
GEMINI_MODEL=gemini-3.6-flash,gemini-3.8-flash,gemini-3.5-flash-lite
# transcription model: must accept audio input
GEMINI_STT_MODEL=gemini-3.6-flash,gemini-3.8-flash,gemini-3.5-flash-lite
# audio chunk length per request (seconds); shorter = more accurate timestamps
GEMINI_STT_CHUNK_SECONDS=600

# --- Limits & policy -----------------------------------------------------------
MAX_UPLOAD_MB=300
MAX_AUDIO_MINUTES=180
TEMP_AUDIO_RETENTION_HOURS=24
RATE_LIMIT_PER_MINUTE=20
DOCX_FONT=Tahoma
DISPLAY_TIMEZONE=Asia/Bangkok
